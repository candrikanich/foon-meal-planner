# The waitlist Edge Function's URL (supabase/functions/waitlist). Read at build time.
NUXT_PUBLIC_WAITLIST_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/waitlist
# The parental-consent Edge Function's URL (supabase/functions/parental-consent), for the /consent pages. Read at build time.
NUXT_PUBLIC_CONSENT_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/parental-consent
# Canonical origin for meta tags. Defaults to https://getfoon.com.
NUXT_PUBLIC_SITE_URL=https://getfoon.com
